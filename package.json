{
  "name": "mound-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mound City — a cold-case detective game (MVP prototype). See docs/GameConceptDocument.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "server": "tsx watch server/index.ts",
    "seed": "tsx server/seed.ts",
    "transfer": "tsx server/transfer.ts",
    "seed:sim": "tsx server/seedSim.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "pg": "^8.21.0"
  }
}
